# Field Service CRM / A3 Platform
# Copy this file to .env for local development.
# Never put real production secrets into git.

# Runtime mode
ENV=development
COOKIE_SECURE=0

# Required in production.
# Generate a long random value before deploy.
SECRET_KEY=replace-with-long-random-secret

# Local data directory.
# Railway can keep the default or point this to a mounted volume.
DATA_DIR=.

# Database backend. Keep SQLite for local development or configure PostgreSQL
# after the migration, backup, and restore rehearsal. Never commit a real URL.
DATABASE_BACKEND=sqlite
# DATABASE_URL=postgresql://user:password@host:5432/database
# POSTGRESQL_EXPERIMENTAL=0
# Optional PostgreSQL backup overrides.
# PG_DUMP_BIN=/usr/bin/pg_dump
# PG_RESTORE_BIN=/usr/bin/pg_restore
# POSTGRES_BACKUP_TIMEOUT_SECONDS=300

# User files and off-site backup mirror.
# Keep local for development. Use s3 in production after a successful sync.
OBJECT_STORAGE_BACKEND=local
# S3_BUCKET=field-service-production
# S3_REGION=eu-central-1
# S3_ENDPOINT_URL=
# S3_PREFIX=field-service
# S3_ADDRESSING_STYLE=auto
# S3_LOCAL_CACHE=1
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_KMS_KEY_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Durable background queue. The defaults fit a one-minute cron worker.
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_STALE_MINUTES=60
BACKGROUND_JOB_WARNING_MINUTES=5
BACKGROUND_JOB_SUCCESS_RETENTION_DAYS=14
BACKGROUND_JOB_FAILED_RETENTION_DAYS=30

# Telegram notifications.
# Leave empty locally if Telegram is not needed.
BOT_TOKEN=
CHAT_ID=

# Secret for protected automation cron endpoints.
# Use a long random value in production.
AUTOMATION_CRON_SECRET=replace-with-long-random-cron-secret

# Calendar scheduler incident policy.
# Defaults are safe; tune only if your dispatch team needs different response windows.
# CALENDAR_INCIDENT_RESPONSE_MINUTES=30
# CALENDAR_INCIDENT_ESCALATION_MINUTES=30
# CALENDAR_INCIDENT_RECOVERY_MINUTES=120
# CALENDAR_WATCHDOG_STALE_HOURS=6
# CALENDAR_SCHEDULER_STUCK_MINUTES=30

# A3 quality alert SLA: hours from first detection; repeat escalation interval.
# A3_QUALITY_ALERT_RESPONSE_HOURS=4
# A3_QUALITY_ALERT_RESOLUTION_HOURS=24
# A3_QUALITY_ALERT_ESCALATION_COOLDOWN_HOURS=12

# Railway sets these automatically. Do not set manually unless needed.
# RAILWAY_ENVIRONMENT=
# RAILWAY_ENVIRONMENT_NAME=
# RAILWAY_GIT_COMMIT_SHA=
# RAILWAY_GIT_BRANCH=
# RAILWAY_DEPLOYMENT_ID=
# RAILWAY_SERVICE_NAME=
